diff --git a/node_modules/react-native-alarm-scheduler/ios/AlarmScheduler/AlarmSchedulerSnooze.swift b/node_modules/react-native-alarm-scheduler/ios/AlarmScheduler/AlarmSchedulerSnooze.swift
