@@ -0,0 +1,150 @@
+import Foundation
+
+#if canImport(AlarmKit)
+import ActivityKit
+import AlarmKit
+import AppIntents
+import SwiftUI
+
+// Pixel Alarm patch: native snooze («Повтор») straight from the ringing alarm,
+// without opening or unlocking the app. The button stops the current ring and
+// schedules a one-shot AlarmKit alarm N seconds later with the same title and sound.
+// The snooze alarm offers the same button again, so snoozes can chain.
+
+/// Stable id of the snooze alarm for a base alarm: the same UUID with the first 4 hex chars
+/// replaced. JS uses the same rule to cancel a pending snooze when the base alarm is deleted.
+func alarmSchedulerSnoozeId(for baseId: String) -> String {
+  let lower = baseId.lowercased()
+  guard lower.count == 36 else {
+    return lower
+  }
+  return "5e00" + String(lower.dropFirst(4))
+}
+
+@available(iOS 26.0, *)
+enum AlarmSchedulerSnooze {
+  static func makeAttributes(
+    baseId: String,
+    title: String,
+    stopTitle: String,
+    snoozeTitle: String
+  ) -> AlarmAttributes<AlarmSchedulerMetadata> {
+    let alert = AlarmPresentation.Alert(
+      title: LocalizedStringResource(stringLiteral: title),
+      stopButton: AlarmButton(
+        text: LocalizedStringResource(stringLiteral: stopTitle),
+        textColor: .white,
+        systemImageName: "stop.fill"
+      ),
+      secondaryButton: AlarmButton(
+        text: LocalizedStringResource(stringLiteral: snoozeTitle),
+        textColor: .white,
+        systemImageName: "zzz"
+      ),
+      secondaryButtonBehavior: .custom
+    )
+    return AlarmAttributes(
+      presentation: AlarmPresentation(alert: alert),
+      metadata: AlarmSchedulerMetadata(alarmId: baseId, title: title, values: [:]),
+      tintColor: Color.accentColor
+    )
+  }
+
+  static func makeSound(_ soundName: String) -> AlertConfiguration.AlertSound {
+    guard let name = alarmSchedulerEffectiveSoundName(soundName.isEmpty ? nil : soundName) else {
+      return .default
+    }
+    return .named(name)
+  }
+}
+
+@available(iOS 26.0, *)
+struct AlarmSchedulerSnoozeIntent: LiveActivityIntent {
+  static var title: LocalizedStringResource = "Snooze Alarm"
+  static var authenticationPolicy: IntentAuthenticationPolicy = .alwaysAllowed
+  static var supportedModes: IntentModes { .background }
+
+  @Parameter(title: "Ringing Alarm ID")
+  var ringingId: String
+  @Parameter(title: "Base Alarm ID")
+  var baseId: String
+  @Parameter(title: "Alarm Title")
+  var alarmTitle: String
+  @Parameter(title: "Stop Title")
+  var stopTitle: String
+  @Parameter(title: "Snooze Title")
+  var snoozeTitle: String
+  @Parameter(title: "Snooze Seconds")
+  var seconds: Double
+  @Parameter(title: "Sound Name")
+  var soundName: String
+
+  init() {
+    ringingId = ""
+    baseId = ""
+    alarmTitle = ""
+    stopTitle = "Stop"
+    snoozeTitle = "Snooze"
+    seconds = 600
+    soundName = ""
+  }
+
+  init(
+    ringingId: String,
+    baseId: String,
+    alarmTitle: String,
+    stopTitle: String,
+    snoozeTitle: String,
+    seconds: Double,
+    soundName: String?
+  ) {
+    self.ringingId = ringingId
+    self.baseId = baseId
+    self.alarmTitle = alarmTitle
+    self.stopTitle = stopTitle
+    self.snoozeTitle = snoozeTitle
+    self.seconds = seconds
+    self.soundName = soundName ?? ""
+  }
+
+  func perform() async throws -> some IntentResult {
+    // 1. Silence the alarm that is ringing now (a repeating base alarm keeps its schedule).
+    if let ringing = UUID(uuidString: ringingId) {
+      try? AlarmManager.shared.stop(id: ringing)
+    }
+
+    // 2. Replace any previous snooze of this alarm with a fresh one.
+    let snoozeIdString = alarmSchedulerSnoozeId(for: baseId)
+    guard let snoozeId = UUID(uuidString: snoozeIdString) else {
+      return .result()
+    }
+    try? AlarmManager.shared.cancel(id: snoozeId)
+
+    let fireDate = Date().addingTimeInterval(max(60, seconds))
+    _ = try? await AlarmManager.shared.schedule(
+      id: snoozeId,
+      configuration: AlarmManager.AlarmConfiguration.alarm(
+        schedule: .fixed(fireDate),
+        attributes: AlarmSchedulerSnooze.makeAttributes(
+          baseId: baseId,
+          title: alarmTitle,
+          stopTitle: stopTitle,
+          snoozeTitle: snoozeTitle
+        ),
+        stopIntent: nil,
+        secondaryIntent: AlarmSchedulerSnoozeIntent(
+          ringingId: snoozeIdString,
+          baseId: baseId,
+          alarmTitle: alarmTitle,
+          stopTitle: stopTitle,
+          snoozeTitle: snoozeTitle,
+          seconds: seconds,
+          soundName: soundName
+        ),
+        sound: AlarmSchedulerSnooze.makeSound(soundName)
+      )
+    )
+    return .result()
+  }
+}
+#endif
